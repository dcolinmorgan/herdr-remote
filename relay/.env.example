# Foreground Telegram bot configuration.
# Managed installs write these to ~/.config/herdr-remote/secrets.env (mode 0600).
HERDR_TG_TOKEN=your-bot-token-here
HERDR_TG_CHAT_ID=your-private-or-negative-group-chat-id

# Relay address used by local WebSocket clients.
HERDR_RELAY=ws://127.0.0.1:8375

# Optional relay shared secret. Add ?token=<same-value> to HERDR_RELAY.
HERDR_RELAY_TOKEN=64-lowercase-hex-characters

# Which local herdr session the relay polls. Leave unset for the default
# session; set it to the session name if your agents run in a named one
# (`herdr --session main`). A managed service inherits nothing from the shell
# that installed it, so an unset value here means the default session's socket.
HERDR_SESSION=

# Remote herdr instances polled by the relay over SSH (comma-separated).
HERDR_REMOTES=user@server1,user@server2
