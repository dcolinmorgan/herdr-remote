<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 gives us the WinRT projection for Windows.UI.Notifications
         with no NuGet dependency at all. Windows App SDK was rejected: its build
         requires Windows-only native tools (mt.exe, makepri.exe) and it would force
         users to install the Windows App Runtime. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <!-- WinForms is here only for NotifyIcon (tray) and Screen (multi-monitor bounds). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Herdi</AssemblyName>
    <RootNamespace>Herdi</RootNamespace>
    <ApplicationIcon>Assets\herdi.ico</ApplicationIcon>
    <Version>0.7.5</Version>
    <AssemblyVersion>0.7.5.0</AssemblyVersion>
    <FileVersion>0.7.5.0</FileVersion>
    <!-- Lets `dotnet build` run on Linux/macOS for compile verification. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010 tells WinForms apps to move DPI config out of the manifest. This is a
         WPF app that only borrows NotifyIcon, so PerMonitorV2 belongs in the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Per-monitor DPI v2: the island is positioned in physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Memory. This process sits in the tray all day beside the editors and browsers the
       user actually came to use, so its resting footprint is a feature.

       Measured on 0.7.3 with dotnet-counters and Task Manager, in that order, because the
       first number that mattered was the one that ruled the code out: the managed heap was
       4.9 MB against ~300 MB of private bytes. None of this was ever the app's own data,
       and no amount of care in the code that does the work would have moved it.

       Where it actually went, and what it is now:

         ~300 MB  startup, compressed self-contained bundle + flyout built during startup
          ~20 MB  startup, uncompressed bundle + flyout built on first use (this file, App)
          ~80 MB  with the flyout open and software rendering (App.ApplyRenderMode)
         ~250 MB  with the flyout open and the GPU path, i.e. 170 MB for a D3D device that
                  a layered window cannot use -->
  <PropertyGroup>
    <!-- No background GC. It exists so gen2 collections do not pause a large heap; this one
         is five megabytes with a ~160 KB/s allocation rate, so what it buys in practice is a
         dedicated thread and a second heap budget held for the life of the process.
         This is tidying, not a fix - the GC was never where the memory was, and it is the
         only GC knob kept for that reason. ServerGarbageCollection=false and
         RetainVMGarbageCollection=false were tried and dropped: both are already the
         default. System.GC.ConserveMemory was tried and dropped too - it trades CPU for a
         few megabytes of a heap this size, and it was never measured to do even that. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Deliberately NOT set, all three of them:

         InvariantGlobalization=true. It would drop the ~30 MB of ICU data a self-contained
         publish otherwise carries, and nothing in this app's own code is culture-sensitive
         - but WPF's is. Every FrameworkElement carries Language="en-us" by default and
         every binding resolves it through XmlLanguage.GetSpecificCulture(), which has no
         culture to find once ICU is gone. The result is an InvalidOperationException
         ("Cannot find non-neutral culture related to 'en-us'") the first time any window
         with a binding is shown. It compiles clean and fails only at runtime, so do not
         re-add it on the strength of a successful build.

         UseSystemResourceKeys=true. Replaces framework exception messages with bare ids,
         and this app puts those messages in the tray menu and its crash dialog.

         EventSourceSupport=false. It would switch off the very counters used to measure
         any of this. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- Compression is a memory decision, not a size one, and it is off for that reason.
         An uncompressed bundle is memory-mapped: assemblies load as file-backed pages the
         OS can share and evict. A compressed one cannot be mapped at all, so the runtime
         decompresses every assembly it loads into private anonymous memory that is never
         shared, never paged out and never returned, and this app loads 74 of them. Turning
         it off and deferring the window together took startup from ~300 MB to ~20 MB; the
         two were never measured apart, so treat that as their combined effect.
         The cost is the download: the exe roughly doubles (69 MB -> ~150 MB). Pass
         -p:EnableCompressionInSingleFile=true (or build.ps1 -Compress) to trade back. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Stamp how this copy was deployed, so Updater can pick the release asset that matches.
       Releases carry both: a self-contained zip that runs anywhere, and a framework-dependent
       one a sixth the size. Handing a self-contained install the smaller asset would leave it
       unable to start on a machine with no .NET 8 Desktop Runtime, and the process has no
       other reliable way to know which it is. Evaluated after the Release PropertyGroup above
       so it sees whatever SelfContained ended up as, including a -p: override from build.ps1.
       A plain `dotnet build` leaves SelfContained empty, which is framework-dependent, which
       is what `dotnet run` actually does. -->
  <PropertyGroup>
    <HerdiDeployment Condition="'$(SelfContained)' == 'true'">self-contained</HerdiDeployment>
    <HerdiDeployment Condition="'$(SelfContained)' != 'true'">framework-dependent</HerdiDeployment>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Deployment" Value="$(HerdiDeployment)" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds System.Drawing/System.Windows.Forms to the implicit usings,
         whose Color/Brush/Size/Point collide with the WPF types this app is built on.
         The two files that touch WinForms import it explicitly instead. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded, not copied: PublishSingleFile does not carry loose content files into
         the bundle, so a file-path lookup would find nothing in a released build. -->
    <EmbeddedResource Include="Assets\herdi.ico" />
    <EmbeddedResource Include="Assets\herdi-blocked.ico" />
  </ItemGroup>

</Project>
