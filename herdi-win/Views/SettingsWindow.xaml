<Window x:Class="Herdi.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Herdi — Relay Settings"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#FF17181A">

    <StackPanel Margin="20">

        <TextBlock Text="Relay URL"
                   FontFamily="{StaticResource UiFont}"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Text90}" />
        <TextBlock Text="ws://127.0.0.1:8375 locally, or the wss:// tunnel URL."
                   Margin="0,2,0,6"
                   FontFamily="{StaticResource UiFont}"
                   FontSize="10"
                   Foreground="{StaticResource Text40}"
                   TextWrapping="Wrap" />
        <TextBox x:Name="UrlBox" Style="{StaticResource ReplyBox}" />

        <TextBlock Text="Relay Token"
                   Margin="0,16,0,0"
                   FontFamily="{StaticResource UiFont}"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Text90}" />
        <TextBlock Text="Required when the relay binds beyond loopback or runs behind a tunnel (HERDR_RELAY_TOKEN). Stored encrypted with DPAPI."
                   Margin="0,2,0,6"
                   FontFamily="{StaticResource UiFont}"
                   FontSize="10"
                   Foreground="{StaticResource Text40}"
                   TextWrapping="Wrap" />
        <PasswordBox x:Name="TokenBox"
                     Background="{StaticResource Fill05}"
                     Foreground="White"
                     CaretBrush="White"
                     BorderBrush="{StaticResource Stroke10}"
                     BorderThickness="0.7"
                     Padding="10,7"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="11" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource PlainButton}"
                    Background="{StaticResource Fill06}"
                    Foreground="{StaticResource Text90}"
                    Padding="14,7"
                    Margin="0,0,8,0"
                    Click="OnCancel" />
            <Button Content="Save &amp; Reconnect"
                    Style="{StaticResource PlainButton}"
                    Background="{StaticResource Blue}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="14,7"
                    Click="OnSave" />
        </StackPanel>

    </StackPanel>
</Window>
