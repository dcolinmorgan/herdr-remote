<UserControl x:Class="Herdi.Views.SessionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Herdi.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:IslandViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- Section header: accent tick, monospaced caps, right-aligned count.
             Port of SectionHeader (NotchContentView.swift:401). -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- One agent row. Port of AgentSessionRow (NotchContentView.swift:427):
             accent bar, name + location, and actions that appear on hover (or always,
             when the agent is blocked). -->
        <DataTemplate x:Key="AgentRowTemplate">
            <Border x:Name="RowRoot"
                    Background="{StaticResource Fill03}"
                    BorderThickness="0.7"
                    BorderBrush="Transparent"
                    CornerRadius="8"
                    Padding="10,7"
                    Margin="0,0,0,4"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Accent bar -->
                    <Border Grid.Column="0"
                            Width="3" Height="28"
                            CornerRadius="1.5"
                            Margin="0,0,8,0"
                            Background="{Binding Status, Converter={StaticResource StatusToBrush}}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text90}" />
                            <!-- Remote marker, standing in for the SF Symbol "network". -->
                            <TextBlock Text="⇄"
                                       Margin="4,0,0,0"
                                       FontSize="9"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Green}"
                                       Opacity="0.6"
                                       Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayLocation}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource Text40}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="200" />
                            <TextBlock FontFamily="{StaticResource MonoFont}"
                                       FontSize="9"
                                       Margin="4,0,0,0"
                                       Foreground="{StaticResource Red}"
                                       Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="180"
                                       Text="{Binding PromptTail, StringFormat=— {0}}"
                                       Visibility="{Binding PromptTail, Converter={StaticResource NonEmptyToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel x:Name="RowActions"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <!-- Quick allow, only when the agent offers the permission option. -->
                        <Button Style="{StaticResource GlyphButton}"
                                Content="✓"
                                Foreground="{StaticResource Green}"
                                FontSize="14"
                                ToolTip="Allow"
                                Command="{Binding DataContext.RespondFromRowCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource GlyphButton}"
                                Content="⊘"
                                Foreground="{StaticResource Red}"
                                FontSize="12"
                                Opacity="0.6"
                                ToolTip="Interrupt (^C)"
                                Command="{Binding DataContext.InterruptCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                    <Setter TargetName="RowRoot" Property="BorderBrush"
                            Value="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                    <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource Fill06}" />
                    <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource QuietScroll}" MaxHeight="320">
        <StackPanel Margin="14,10">

            <!-- Update banner. Port of UpdateBanner (NotchContentView.swift:345). -->
            <Border CornerRadius="8"
                    BorderThickness="0.7"
                    Padding="10,8"
                    Margin="0,0,0,8"
                    Background="#1464D2FF"
                    BorderBrush="#3364D2FF"
                    Visibility="{Binding Updater.UpdateAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⬇" FontSize="14" Margin="0,0,8,0"
                               VerticalAlignment="Center" Foreground="{StaticResource Cyan}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Update available"
                                   FontFamily="{StaticResource UiFont}" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource Text90}" />
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{StaticResource Text60}">
                            <Run Text="v" /><Run Text="{Binding Updater.CurrentVersion, Mode=OneWay}" /><Run Text=" → v" /><Run Text="{Binding Updater.LatestVersion, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource PlainButton}"
                            Background="{StaticResource Cyan}"
                            Foreground="Black"
                            Padding="10,5"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Content="Install"
                            Click="OnInstallUpdate" />
                </Grid>
            </Border>

            <!-- NEEDS YOU -->
            <StackPanel Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,4,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="10" CornerRadius="1" Margin="0,0,5,0"
                                Background="{StaticResource Red}" />
                        <TextBlock Text="NEEDS YOU" Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource Red}" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Text="{Binding Blocked.Count}" HorizontalAlignment="Right"
                               Style="{StaticResource SectionTitle}" FontWeight="Medium"
                               Foreground="{StaticResource Text30}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Blocked}"
                              ItemTemplate="{StaticResource AgentRowTemplate}"
                              PreviewMouseLeftButtonUp="OnRowClicked" />
            </StackPanel>

            <!-- WORKING -->
            <StackPanel Visibility="{Binding HasWorking, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,4,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="10" CornerRadius="1" Margin="0,0,5,0"
                                Background="{StaticResource Green}" />
                        <TextBlock Text="WORKING" Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource Green}" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Text="{Binding Working.Count}" HorizontalAlignment="Right"
                               Style="{StaticResource SectionTitle}" FontWeight="Medium"
                               Foreground="{StaticResource Text30}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Working}"
                              ItemTemplate="{StaticResource AgentRowTemplate}" />
            </StackPanel>

            <!-- IDLE -->
            <StackPanel Visibility="{Binding HasIdle, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,4,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="10" CornerRadius="1" Margin="0,0,5,0"
                                Background="{StaticResource Gray}" />
                        <TextBlock Text="IDLE" Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource Gray}" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Text="{Binding Idle.Count}" HorizontalAlignment="Right"
                               Style="{StaticResource SectionTitle}" FontWeight="Medium"
                               Foreground="{StaticResource Text30}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Idle}"
                              ItemTemplate="{StaticResource AgentRowTemplate}" />
            </StackPanel>

            <!-- Empty state -->
            <TextBlock HorizontalAlignment="Center"
                       Margin="0,30"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="11"
                       Foreground="{StaticResource Text40}"
                       Visibility="{Binding HasNoAgents, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Connecting…" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Text" Value="No agents" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Version footer -->
            <TextBlock HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="9"
                       Foreground="{StaticResource Text20}">
                <Run Text="v" /><Run Text="{Binding Updater.CurrentVersion, Mode=OneWay}" />
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
