<Window x:Class="Herdi.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Herdi.Controls"
        xmlns:views="clr-namespace:Herdi.Views"
        xmlns:vm="clr-namespace:Herdi.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:IslandViewModel}"
        mc:Ignorable="d"
        Title="Herdi"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- The island: silhouette behind, content in front, sized by the content so the
         window has almost no transparent area to swallow clicks. -->
    <Grid x:Name="Root" MouseEnter="OnRootMouseEnter" MouseLeave="OnRootMouseLeave">

        <controls:IslandShape x:Name="Silhouette"
                              Fill="{StaticResource IslandFill}"
                              TopExtension="3"
                              BottomRadius="12" />

        <StackPanel x:Name="Body">

            <!-- Compact bar, always present. Port of CompactBar (NotchContentView.swift:179). -->
            <Grid x:Name="CompactBar" Height="32"
                  Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left wing: connection dot, blocked count, working count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <Ellipse Width="7" Height="7">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Red}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Green}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0"
                                Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⚠" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Red}" />
                        <TextBlock Text="{Binding Blocked.Count}"
                                   Margin="2,0,0,0"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Red}" />
                    </StackPanel>

                    <!-- Visibility comes from ApplyWorkingCount, not a binding: the pulsing
                         count belongs to the collapsed island only, so it follows the
                         surface as well as how many agents are working. -->
                    <StackPanel x:Name="WorkingCount" Orientation="Horizontal" Margin="5,0,0,0"
                                Visibility="Collapsed">
                        <Ellipse Style="{StaticResource PulsingDot}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Working.Count}"
                                   Margin="2,0,0,0"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text90}" />
                    </StackPanel>
                </StackPanel>

                <!-- Centre: wordmark, only while expanded -->
                <TextBlock x:Name="Wordmark"
                           Grid.Column="1"
                           Text="herdr"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text90}"
                           Visibility="Collapsed" />

                <!-- Right wing: update badge + total agent count -->
                <StackPanel x:Name="RightWing"
                            Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource GlyphButton}"
                            Content="⬇"
                            FontSize="11"
                            Foreground="{StaticResource Cyan}"
                            ToolTip="Show update"
                            Click="OnShowUpdate"
                            Visibility="{Binding Updater.UpdateAvailable, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding AgentCount}"
                               Margin="4,0,0,0"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10" FontWeight="Medium"
                               Foreground="{StaticResource Text40}" />
                </StackPanel>
            </Grid>

            <!-- Idle bar, shown when no agents are running.
                 Port of IdleBar (NotchContentView.swift:254). -->
            <StackPanel x:Name="IdleBar" Height="32" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisInverted}}">
                <Ellipse Width="5" Height="5" VerticalAlignment="Center" Opacity="0.5">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Red}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Green}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="herdr" Margin="6,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="10" FontWeight="Medium"
                           Foreground="{StaticResource Text30}" />
            </StackPanel>

            <!-- Divider + expanded surface -->
            <Border x:Name="Divider" Height="0.7" Margin="12,0"
                    Background="{StaticResource Stroke15}"
                    Visibility="Collapsed" />

            <Grid x:Name="ExpandedHost" Visibility="Collapsed">
                <views:SessionListView x:Name="SessionList"
                                       Visibility="{Binding ShowSessionListSurface, Converter={StaticResource BoolToVis}}" />
                <views:ApprovalCardView x:Name="ApprovalCard"
                                        Visibility="{Binding ShowApprovalSurface, Converter={StaticResource BoolToVis}}" />
            </Grid>

        </StackPanel>
    </Grid>
</Window>
