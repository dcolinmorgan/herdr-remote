<UserControl x:Class="Herdi.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Herdi.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:IslandViewModel}"
             mc:Ignorable="d">

    <!-- One agent's terminal, live. No macOS counterpart: there a row jumps to the pane in
         the terminal app, which only works on the machine running herdr. -->
    <StackPanel>

        <!-- Header: back, accent, agent · location, refresh, interrupt -->
        <Grid Margin="14,10,14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GlyphButton}"
                        Content="‹"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource Text60}"
                        ToolTip="Back (Esc)"
                        Command="{Binding DismissCommand}" />
                <Border Width="3" Height="14" CornerRadius="2" Margin="6,0,8,0"
                        Background="{Binding ActiveAgent.Status, Converter={StaticResource StatusToBrush}}" />
                <TextBlock Text="{Binding ActiveAgent.Name}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="⇄"
                           Margin="4,0,0,0"
                           FontSize="9"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Green}"
                           Opacity="0.6"
                           Visibility="{Binding ActiveAgent.IsRemote, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="·" Margin="5,0" Foreground="{StaticResource Text30}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActiveAgent.DisplayLocation}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10"
                           Foreground="{StaticResource Text60}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GlyphButton}"
                        Content="⟳"
                        FontSize="13"
                        Foreground="{StaticResource Text60}"
                        ToolTip="Read again"
                        Command="{Binding RefreshPaneCommand}" />
                <Button Style="{StaticResource GlyphButton}"
                        Content="⊘"
                        FontSize="13"
                        Foreground="{StaticResource Red}"
                        Opacity="0.7"
                        ToolTip="Interrupt (^C)"
                        Command="{Binding InterruptCommand}"
                        CommandParameter="{Binding ActiveAgent}"
                        Visibility="{Binding ActiveAgent.CanInterrupt, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Terminal content -->
        <Border Margin="12,10,12,0"
                CornerRadius="8"
                BorderThickness="0.7"
                Background="{StaticResource Fill03}"
                BorderBrush="{StaticResource Stroke06}">
            <ScrollViewer x:Name="PaneScroll" Style="{StaticResource QuietScroll}"
                          MaxHeight="260" Padding="8">
                <Grid>
                    <!-- Wrapped rather than clipped: at this size a terminal line runs wider
                         than the island, and a horizontal scrollbar is the one piece of
                         stock chrome this UI has nowhere to put. -->
                    <TextBlock Text="{Binding PaneContent, NotifyOnTargetUpdated=True}"
                               Binding.TargetUpdated="OnPaneContentUpdated"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               LineHeight="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text90}" />

                    <TextBlock Margin="2"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Foreground="{StaticResource Text30}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Reading pane…" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PaneContent, Converter={StaticResource NonEmptyToVis}}"
                                                 Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Submit free-form text. Goes out as agent_prompt in both modes, which is what
             `herdr agent prompt` is for — see RelayConnection.SendPrompt. -->
        <Grid Margin="12,10,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInput"
                     Grid.Column="0"
                     Style="{StaticResource ReplyBox}"
                     Tag="Message this agent…"
                     Text="{Binding PaneInput, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnInputKeyDown" />
            <Button Grid.Column="1"
                    Margin="6,0,0,0"
                    Content="↑"
                    FontSize="18"
                    FontWeight="Bold"
                    ToolTip="Send (Enter)"
                    Command="{Binding SendPaneInputCommand}"
                    IsEnabled="{Binding CanSendPaneInput}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                        <Setter Property="Foreground" Value="{StaticResource Text20}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanSendPaneInput}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Blue}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

    </StackPanel>
</UserControl>
